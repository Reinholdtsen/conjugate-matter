  lam =   1.0: t = 0.0: lam*V_lam = 0.0e+00, total = -4.0000e+00; t = 2.0: lam*V_lam = 1.2e-24, total = -2.9830e+03; t = 4.0: lam*V_lam = 2.7e-14, total = -8.8861e+06
  lam = 100.0: t = 0.0: lam*V_lam = 0.0e+00, total = -4.0000e+00; t = 2.0: lam*V_lam = 1.2e-22, total = -2.9830e+03; t = 4.0: lam*V_lam = 2.7e-12, total = -8.8861e+06

== H. The naive term by itself does not involve H: on the whole K-target it is unbounded at ANY H
  s = 0.0: V_mu(K_hyp(s, 0)) = -4.0000e+00  (= -4 cosh^2 s = -4.0000e+00)
  s = 3.0: V_mu(K_hyp(s, 0)) = -4.0543e+02  (= -4 cosh^2 s = -4.0543e+02)
  s = 6.0: V_mu(K_hyp(s, 0)) = -1.6276e+05  (= -4 cosh^2 s = -1.6276e+05)

